{
	"name": "n8n-nodes-pinglet",
	"version": "1.0.0",
	"description": "n8n community node for Pinglet, a webhook to push notification service",
	"keywords": [
		"n8n-community-node-package",
		"pinglet",
		"push",
		"notifications",
		"apns",
		"fcm"
	],
	"license": "MIT",
	"homepage": "https://pinglet.dev",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/TheGlenn88/n8n-nodes-pinglet.git"
	},
	"bugs": {
		"url": "https://github.com/TheGlenn88/n8n-nodes-pinglet/issues"
	},
	"author": {
		"name": "Bitnix Limited",
		"email": "support@pinglet.dev"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/PingletApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Pinglet/Pinglet.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.3",
		"eslint": "9.32.0",
		"prettier": "3.6.2",
		"release-it": "^19.0.4",
		"typescript": "5.9.2"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
